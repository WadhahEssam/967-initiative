# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. NEVER prefix with NEXT_PUBLIC_ or commit to Git.
SUPABASE_SERVICE_ROLE_KEY=
# Set to your actual production URL after deployment
NEXT_PUBLIC_SITE_URL=https://967ye.com
# Optional but strongly recommended anti-spam protection for public contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional server-only HMAC secret for shared contact limits. Defaults to the
# server service-role key; never expose it with NEXT_PUBLIC_.
CONTACT_RATE_LIMIT_SECRET=
# «سوق 967» photos: a private Backblaze B2 bucket (S3 API), server-only. Needed before launch.
MARKET_S3_ENDPOINT=
MARKET_S3_REGION=
MARKET_S3_BUCKET=
MARKET_S3_KEY_ID=
MARKET_S3_SECRET=
# Optional: key prefix (local development uses tmp/dev/), HMAC secret for chat photo links
# (defaults to the service-role key), and the disk cache folder for photos (defaults to the OS temp).
MARKET_S3_KEY_PREFIX=
MARKET_IMAGE_SECRET=
MARKET_IMAGE_CACHE=
